@using MovieWatchList.Models
@using MovieWatchList.ViewModels.Components
@inherits ViewModelComponentBase<MovieCardViewModel>

<div class="movie-card">
    <div class="movie-card__poster-wrapper">
        <div class="movie-card__poster">
            @if (ViewModel.IsLoadingPoster)
            {
                <div class="movie-card__poster-skeleton skeleton-shimmer">
                    <div class="skeleton-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5">
                            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                            <circle cx="9" cy="9" r="2"></circle>
                            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                        </svg>
                    </div>
                </div>
            }
            else if (ViewModel.ErrorMessage is not null || ViewModel.PosterUrl is null)
            {
                <div class="movie-card__poster-fallback">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="1.5">
                        <rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"></rect>
                        <line x1="7" x2="7" y1="2" y2="22"></line>
                        <line x1="17" x2="17" y1="2" y2="22"></line>
                        <line x1="2" x2="22" y1="12" y2="12"></line>
                        <line x1="2" x2="7" y1="7" y2="7"></line>
                        <line x1="2" x2="7" y1="17" y2="17"></line>
                        <line x1="17" x2="22" y1="17" y2="17"></line>
                        <line x1="17" x2="22" y1="7" y2="7"></line>
                    </svg>
                    <span>Poster unavailable</span>
                </div>
            }
            else
            {
                <img class="movie-card__image" src="@ViewModel.PosterUrl" alt="@Movie.Title poster" loading="lazy" />
                <div class="movie-card__poster-overlay"></div>
            }
        </div>
        <div class="movie-card__poster-badge">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#e8b04b" stroke="#e8b04b">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>@Movie.Rating.ToString("0.0")</span>
        </div>
    </div>
    
    <div class="movie-card__content">
        <MovieInfo Movie="Movie" Variant="card" />

        <div class="movie-card__actions">
            @if (IsInWatchList)
            {
                <button class="btn btn--added" disabled aria-label="Added to watchlist">
                    <span class="btn__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </span>
                    <span>In Watchlist</span>
                </button>
            }
            else
            {
                <button class="btn btn--add" @onclick="() => OnAddToWatchList.InvokeAsync(Movie)" aria-label="Add @Movie.Title to watchlist">
                    <span class="btn__icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span>Add to Watchlist</span>
                </button>
            }

            <NavLink class="btn-details" href="@($"/movies/details/{Movie.Id}")">
                <span>Details</span>
                <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </NavLink>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public Movie Movie { get; set; } = default!;

    [Parameter]
    public EventCallback<Movie> OnAddToWatchList { get; set; }

    [Parameter]
    public bool IsInWatchList { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadPosterAsync(Movie.Title);
    }
}
