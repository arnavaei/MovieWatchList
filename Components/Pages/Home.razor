@page "/"
@rendermode InteractiveServer
@using MovieWatchList.Models
@using MovieWatchList.ViewModels.Pages
@inject MovieListViewModel ViewModel


<PageTitle>Home</PageTitle>

<div class="page">
    <header class="page__header">
        <h1 class="page__title">Movie Watchlist</h1>
        <p class="page__subtitle">@ViewModel.Movies.Count movies in your collection</p>
    </header>

    <section class="movie-grid">
        @foreach (var movie in ViewModel.Movies)
        {
            <MovieCard
                @key="movie.Id"
                Movie="movie"
                OnAddToWatchList="movie => ViewModel.AddToWatchListAsync(movie)"
                IsInWatchList="@ViewModel.WatchList.Any(m => m.Id == movie.Id)" />
        }
    </section>

    <hr class="divider" />

    <section class="watchlist">
        <h2 class="watchlist__title">My Watchlist <span class="watchlist__count">@ViewModel.WatchList.Count</span></h2>

        @if (ViewModel.WatchList.Count == 0)
        {
            <p class="watchlist__empty">Your watchlist is empty. Add movies from above.</p>
        }
        else
        {
            <div class="watchlist__items">
                @foreach (var movie in ViewModel.WatchList)
                {
                    <div class="watchlist-item">
                        <div>
                            <span class="watchlist-item__title">@movie.Title</span>
                            <span class="watchlist-item__year">@movie.ReleaseDate</span>
                        </div>
                        <button class="watchlist-item__remove" @onclick="() => ViewModel.RemoveFromWatchListAsync(movie)">
                            Remove
                        </button>
                    </div>
                }
            </div>
        }
    </section>
</div>




@code
{
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoacAsync();
    }
}
