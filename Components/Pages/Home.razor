@page "/"
@rendermode InteractiveServer
@using MovieWatchList.Models

<PageTitle>Home</PageTitle>

<h1>Movie WatchList</h1>
<h3>Movies: @movies.Count</h3>
<p>My Movies Collection</p>

@foreach (var movie in movies)
{
    <MovieCard 
        @key="movie.Id"
        Movie="movie"
        OnAddToWatchList="HandleAddToWatchList"
        IsInWatchList="@watchList.Any(m => m.Id == movie.Id)" />
}

<hr/>

<h2>My WatchList (@watchList.Count)</h2>

@if (watchList.Count == 0)
{
    <p>List is empty. add from above</p>
}
else
{
    @foreach (var movie in watchList)
    {
        <div class="watchlist-item">
            <span>@movie.Title (@movie.ReleaseDate)</span>
            <button @onclick="() => RemoveFromWatchList(movie)">Remove</button>
        </div>
    }
}

@code
{
    List<Movie> movies = new()
    {
        new Movie
        {
            Id = 1,
            Title = "Inception",
            ReleaseDate = 2010,
            Director = "Christopher Nolan",
            Genre = "Sci-Fi",
            Rating = 8.8
        },
        new Movie
        {
            Id = 2,
            Title = "Interstellar",
            ReleaseDate = 2014,
            Director = "Christopher Nolan",
            Genre = "Sci-Fi",
            Rating = 8.7
        },
        new Movie
        {
            Id = 3,
            Title = "The Dark Knight",
            ReleaseDate = 2008,
            Director = "Christopher Nolan",
            Genre = "Action",
            Rating = 9.0
        }
    };

    List<Movie> watchList = new();

    void HandleAddToWatchList(Movie movie)
    {
        if (!watchList.Any(m => m.Id == movie.Id))
        {
            watchList.Add(movie);
        }
    }

    void RemoveFromWatchList(Movie movie)
    {
        watchList.Remove(movie);
    }
}