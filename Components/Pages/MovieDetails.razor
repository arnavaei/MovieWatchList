@page "/movies/details/{Id:int}"
@rendermode InteractiveServer
@using MovieWatchList.ViewModels.Pages
@inherits ViewModelComponentBase<MovieDetailsViewModel>
@inject NavigationManager Navigation

<PageTitle>@(ViewModel.Movie?.Title ?? "Movie Details") | CineTrack</PageTitle>

<div class="details-page">
    <!-- Top Navigation Bar -->
    <nav class="details-nav">
        <button class="btn-back" @onclick="GoBack" aria-label="Back to movie list">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Movies</span>
        </button>

        <div class="breadcrumb-trail">
            <NavLink href="/movies" class="breadcrumb-link">Movies</NavLink>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">@(ViewModel.Movie?.Title ?? "Details")</span>
        </div>
    </nav>

    @if (ViewModel.IsLoading)
    {
        <div class="details-skeleton">
            <div class="skeleton-poster-box skeleton-shimmer"></div>
            <div class="skeleton-info-box">
                <div class="skeleton-shimmer" style="height: 28px; width: 140px; border-radius: 999px;"></div>
                <div class="skeleton-shimmer" style="height: 48px; width: 80%; border-radius: 8px;"></div>
                <div class="skeleton-shimmer" style="height: 24px; width: 40%; border-radius: 6px;"></div>
                <div class="skeleton-grid">
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                </div>
                <div class="skeleton-shimmer" style="height: 48px; width: 220px; border-radius: 10px;"></div>
            </div>
        </div>
    }
    else if (ViewModel.ErrorMessage is not null)
    {
        <div class="state-card state-card--error">
            <div class="state-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h2 class="state-title">Something Went Wrong</h2>
            <p class="state-message">@ViewModel.ErrorMessage</p>
            <button class="btn-action" @onclick="ReloadMovie">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2v6h-6"></path>
                    <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
                    <path d="M3 22v-6h6"></path>
                    <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
                </svg>
                <span>Try Again</span>
            </button>
        </div>
    }
    else if (ViewModel.Movie is null)
    {
        <div class="state-card state-card--notfound">
            <div class="state-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"></rect>
                    <line x1="7" x2="7" y1="2" y2="22"></line>
                    <line x1="17" x2="17" y1="2" y2="22"></line>
                    <line x1="2" x2="22" y1="12" y2="12"></line>
                    <line x1="2" x2="7" y1="7" y2="7"></line>
                    <line x1="2" x2="7" y1="17" y2="17"></line>
                    <line x1="17" x2="22" y1="17" y2="17"></line>
                    <line x1="17" x2="22" y1="7" y2="7"></line>
                </svg>
            </div>
            <h2 class="state-title">Movie Not Found</h2>
            <p class="state-message">We couldn't locate a film with ID #@Id in the archive.</p>
            <NavLink class="btn-action" href="/movies">
                <span>Explore Other Movies</span>
            </NavLink>
        </div>
    }
    else
    {
        <!-- Movie Spotlight Display -->
        <div class="spotlight">
            @if (ViewModel.PosterUrl is not null)
            {
                <div class="spotlight__backdrop" style="background-image: url('@ViewModel.PosterUrl');"></div>
            }

            <div class="spotlight__content">
                <!-- Left Poster Showcase -->
                <div class="poster-container">
                    <div class="poster-card">
                        @if (ViewModel.PosterUrl is not null)
                        {
                            <img class="poster-card__img" src="@ViewModel.PosterUrl" alt="@ViewModel.Movie.Title poster" />
                        }
                        else
                        {
                            <div class="poster-card__placeholder">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="1.5">
                                    <rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"></rect>
                                    <line x1="7" x2="7" y1="2" y2="22"></line>
                                    <line x1="17" x2="17" y1="2" y2="22"></line>
                                    <line x1="2" x2="22" y1="12" y2="12"></line>
                                    <line x1="2" x2="7" y1="7" y2="7"></line>
                                    <line x1="2" x2="7" y1="17" y2="17"></line>
                                    <line x1="17" x2="22" y1="17" y2="17"></line>
                                    <line x1="17" x2="22" y1="7" y2="7"></line>
                                </svg>
                                <span>No Poster Available</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Information Section -->
                <div class="info-container">
                    <MovieInfo Movie="ViewModel.Movie" Variant="detail" />

                    <!-- Actions -->
                    <div class="actions-row">
                        @if (ViewModel.IsInWatchList)
                        {
                            <button class="btn-watchlist-toggle btn-watchlist-toggle--active" disabled>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>In Your Watchlist</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn-watchlist-toggle btn-watchlist-toggle--add" @onclick="AddToWatchList">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add to Watchlist</span>
                            </button>
                        }

                        <button class="btn-ghost-back" @onclick="GoBack">
                            <span>Browse All</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Previous / Next Movie Bottom Bar -->
        <footer class="pagination-footer">
            <div class="pagination-track">
                @if (ViewModel.PreviousMovie is not null)
                {
                    <NavLink class="nav-card nav-card--prev" href="@($"/movies/details/{ViewModel.PreviousMovie.Id}")">
                        <span class="nav-card__arrow">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                        </span>
                        <div class="nav-card__text">
                            <span class="nav-card__dir">Previous Film</span>
                            <span class="nav-card__title">@ViewModel.PreviousMovie.Title</span>
                        </div>
                    </NavLink>
                }
                else
                {
                    <div class="nav-card nav-card--disabled">
                        <span class="nav-card__dir">First Film in Archive</span>
                    </div>
                }

                @if (ViewModel.NextMovie is not null)
                {
                    <NavLink class="nav-card nav-card--next" href="@($"/movies/details/{ViewModel.NextMovie.Id}")">
                        <div class="nav-card__text nav-card__text--right">
                            <span class="nav-card__dir">Next Film</span>
                            <span class="nav-card__title">@ViewModel.NextMovie.Title</span>
                        </div>
                        <span class="nav-card__arrow">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </NavLink>
                }
                else
                {
                    <div class="nav-card nav-card--disabled nav-card--right">
                        <span class="nav-card__dir">Last Film in Archive</span>
                    </div>
                }
            </div>
        </footer>
    }
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    private int _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await ViewModel.LoadMovieAsync(Id);
    }

    void GoBack()
    {
        Navigation.NavigateTo("/movies");
    }

    async Task ReloadMovie()
    {
        await ViewModel.LoadMovieAsync(Id);
    }

    async Task AddToWatchList()
    {
        await ViewModel.AddToWatchListAsync();
    }
}
