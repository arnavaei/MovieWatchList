@page "/movies/details/{Id:int}"
@using MovieWatchList.ViewModels.Pages
@inject MovieDetailsViewModel ViewModel
@inject NavigationManager Navigation

<button @onclick="GoBack">
    ← Back to Movies
</button>

<h1>Movie Details</h1>

<p>Movie ID: @Id</p>
@if (ViewModel.IsLoading)
{
    <p>Loading...</p>
}
else if (ViewModel.ErrorMessage is not null)
{
    <h2>Something Went Wrong</h2>
    <p>@ViewModel.ErrorMessage</p>
    <button @onclick="ReloadMovie">
        Try Again
    </button>
}
else if (ViewModel.Movie is null)
{
    <h2>Movie Not Found :(</h2>
    <p>We couldn't find a movie with ID @Id</p>
    
    <NavLink href="/">
        ← Back to Movies
    </NavLink>
}
else
{
    <div class="movie-details">
        
        @if (ViewModel.PosterUrl is not null)
        {
            <div class="movie-details__poster">
                <img src="@ViewModel.PosterUrl" alt="@ViewModel.Movie.Title Poster"/>
            </div>
        }
        <div class="movie-details__info">
            <MovieInfo Movie="ViewModel.Movie" />

            @if (ViewModel.IsInWatchList)
            {
                <button disabled>
                    ✓ Added to Watchlist
                </button>
            }
            else
            {
                <button @onclick="AddToWatchList">
                    + Add To Watchlist
                </button>
            }
        </div>
            
    </div>
}

<div class="movie-navigation">
    @if (ViewModel.PreviousMovie is not null)
    {
        <NavLink href="@($"/movies/details/{ViewModel.PreviousMovie.Id}")">
            ← Previous Movie
            </NavLink>

    }
    @if (ViewModel.NextMovie is not null)
    {
        <NavLink href="@($"/movies/details/{ViewModel.NextMovie.Id}")">
            Next Movie →
        </NavLink>
    }
</div>

@code
{
    [Parameter]
    public int Id {get; set;}

    protected override async Task OnParametersSetAsync()
    {
        await ViewModel.LoadMovieAsync(Id);
    }

    void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    async Task ReloadMovie()
    {
        await ViewModel.LoadMovieAsync(Id);
    }

    async Task AddToWatchList()
    {
        await ViewModel.AddToWatchListAsync();
    }
}