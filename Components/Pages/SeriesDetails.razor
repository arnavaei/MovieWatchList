@page "/series/details/{Id:int}"
@rendermode InteractiveServer
@using MovieWatchList.ViewModels.Pages
@inherits ViewModelComponentBase<SeriesDetailsViewModel>
@inject NavigationManager Navigation

<PageTitle>@(ViewModel.Series?.Title ?? "Series Details") | CineTrack</PageTitle>

<div class="details-page">
    <!-- Top Navigation Bar -->
    <nav class="details-nav">
        <button class="btn-back" @onclick="GoBack" aria-label="Back to list">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>@(IsRealityShow ? "Back to Reality Shows" : "Back to TV Series")</span>
        </button>

        <div class="breadcrumb-trail">
            <NavLink href="@(IsRealityShow ? "/reality" : "/series")" class="breadcrumb-link">@(IsRealityShow ? "Reality Shows" : "TV Series")</NavLink>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">@(ViewModel.Series?.Title ?? "Details")</span>
        </div>
    </nav>

    @if (ViewModel.IsLoading)
    {
        <div class="details-skeleton">
            <div class="skeleton-poster-box skeleton-shimmer"></div>
            <div class="skeleton-info-box">
                <div class="skeleton-shimmer" style="height: 28px; width: 140px; border-radius: 999px;"></div>
                <div class="skeleton-shimmer" style="height: 48px; width: 80%; border-radius: 8px;"></div>
                <div class="skeleton-shimmer" style="height: 24px; width: 40%; border-radius: 6px;"></div>
                <div class="skeleton-grid">
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                    <div class="skeleton-shimmer" style="height: 70px; border-radius: 12px;"></div>
                </div>
                <div class="skeleton-shimmer" style="height: 48px; width: 220px; border-radius: 10px;"></div>
            </div>
        </div>
    }
    else if (ViewModel.ErrorMessage is not null)
    {
        <div class="state-card state-card--error">
            <div class="state-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <h2 class="state-title">Something Went Wrong</h2>
            <p class="state-message">@ViewModel.ErrorMessage</p>
            <button class="btn-action" @onclick="ReloadSeries">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2v6h-6"></path>
                    <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
                    <path d="M3 22v-6h6"></path>
                    <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
                </svg>
                <span>Try Again</span>
            </button>
        </div>
    }
    else if (ViewModel.Series is null)
    {
        <div class="state-card state-card--notfound">
            <div class="state-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="15" x="2" y="7" rx="2" ry="2"></rect>
                    <polyline points="17 2 12 7 7 2"></polyline>
                </svg>
            </div>
            <h2 class="state-title">@(IsRealityShow ? "Reality Show Not Found" : "TV Series Not Found")</h2>
            <p class="state-message">We couldn't locate a @(IsRealityShow ? "reality show" : "TV series") with ID #@Id in the archive.</p>
            <NavLink class="btn-action" href="@(IsRealityShow ? "/reality" : "/series")">
                <span>@(IsRealityShow ? "Explore Other Reality Shows" : "Explore Other TV Series")</span>
            </NavLink>
        </div>
    }
    else
    {
        <!-- TV Series Spotlight Display -->
        <div class="spotlight">
            @if (ViewModel.PosterUrl is not null)
            {
                <div class="spotlight__backdrop" style="background-image: url('@ViewModel.PosterUrl');"></div>
            }

            <div class="spotlight__content">
                <!-- Left Poster Showcase -->
                <div class="poster-container">
                    <div class="poster-card">
                        @if (ViewModel.PosterUrl is not null)
                        {
                            <img class="poster-card__img" src="@ViewModel.PosterUrl" alt="@ViewModel.Series.Title poster" />
                        }
                        else
                        {
                            <div class="poster-card__placeholder">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="1.5">
                                    <rect width="20" height="15" x="2" y="7" rx="2" ry="2"></rect>
                                    <polyline points="17 2 12 7 7 2"></polyline>
                                </svg>
                                <span>No Poster Available</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Information Section -->
                <div class="info-container">
                    <SeriesInfo Series="ViewModel.Series" Variant="detail" />

                    <!-- Actions -->
                    <div class="actions-row">
                        @if (ViewModel.IsInWatchList)
                        {
                            <button class="btn-watchlist-toggle btn-watchlist-toggle--active" disabled>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>In Your Watchlist</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn-watchlist-toggle btn-watchlist-toggle--add" @onclick="AddToWatchList">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Add to Watchlist</span>
                            </button>
                        }

                        <button class="btn-ghost-back" @onclick="GoBack">
                            <span>@(IsRealityShow ? "Browse All Reality Shows" : "Browse All Series")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Previous / Next TV Series Bottom Bar -->
        <footer class="pagination-footer">
            <div class="pagination-track">
                @if (ViewModel.PreviousSeries is not null)
                {
                    <NavLink class="nav-card nav-card--prev" href="@($"/series/details/{ViewModel.PreviousSeries.Id}")">
                        <span class="nav-card__arrow">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                        </span>
                        <div class="nav-card__text">
                            <span class="nav-card__dir">Previous Show</span>
                            <span class="nav-card__title">@ViewModel.PreviousSeries.Title</span>
                        </div>
                    </NavLink>
                }
                else
                {
                    <div class="nav-card nav-card--disabled">
                        <span class="nav-card__dir">First Show in Archive</span>
                    </div>
                }

                @if (ViewModel.NextSeries is not null)
                {
                    <NavLink class="nav-card nav-card--next" href="@($"/series/details/{ViewModel.NextSeries.Id}")">
                        <div class="nav-card__text nav-card__text--right">
                            <span class="nav-card__dir">Next Show</span>
                            <span class="nav-card__title">@ViewModel.NextSeries.Title</span>
                        </div>
                        <span class="nav-card__arrow">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </NavLink>
                }
                else
                {
                    <div class="nav-card nav-card--disabled nav-card--right">
                        <span class="nav-card__dir">Last Show in Archive</span>
                    </div>
                }
            </div>
        </footer>
    }
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    private int _loadedId;
    private bool IsRealityShow => ViewModel.Series?.IsRealityShow == true;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await ViewModel.LoadSeriesAsync(Id);
    }

    void GoBack()
    {
        Navigation.NavigateTo(IsRealityShow ? "/reality" : "/series");
    }

    async Task ReloadSeries()
    {
        await ViewModel.LoadSeriesAsync(Id);
    }

    async Task AddToWatchList()
    {
        await ViewModel.AddToWatchListAsync();
    }
}
